# Puerto de la API
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Conexión a PostgreSQL.
# Si se omite, la API usa un repositorio en memoria (ideal para probar sin DB).
# Neon: postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/estudio_track?sslmode=require
DATABASE_URL=

# Origen permitido para el frontend.
# En producción: https://tu-sitio.netlify.app
CORS_ORIGIN=*
